# Seeed Studio XIAO ESP32-C5: ESP32-C5, 8 MB QIO flash, 8 MB quad PSRAM, native
# USB (USB-Serial/JTAG, 303a:1001). A status light board, without the full UI.
# Load last, after sdkconfig.defaults.
#
# Same chip, flash and PSRAM as the C5 DevKitC-1 the defaults target, so only the
# status light differs. Sources: Seeed wiki pin table (USER_LED GPIO27 yellow,
# Boot GPIO28), https://wiki.seeedstudio.com/xiao_esp32c5_getting_started/, and
# the Arduino-ESP32 XIAO_ESP32C5 variant (LED_BUILTIN 27, flash_mode qio).
CONFIG_IDF_TARGET="esp32c5"
# The user LED on GPIO27 is a plain yellow LED, not an addressable RGB one.
# Status colours show as brightness and the breathing/blinking pattern.
CONFIG_HOMEHUB_LED_BACKEND_MONO_GPIO=y
CONFIG_HOMEHUB_LED_MONO_GPIO=27
CONFIG_HOMEHUB_LED_MONO_ACTIVE_LOW=y
# BOOT button, active low, confirms pairing and long-press-resets setup.
CONFIG_HOMEHUB_BUTTON_GPIO=28
